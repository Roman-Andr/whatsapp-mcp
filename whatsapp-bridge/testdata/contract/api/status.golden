### GET /api/status  (auth: bearer)
< 200
< Content-Type: application/json
{"connected":false,"full_text_search":true,"jid":"79990000001@s.whatsapp.net","pairing":{"linked":true},"read_allowlist":[],"read_only":false,"send_allowlist":[],"session":{"state":"client_outdated","reason":"WhatsApp rejected this client version; update whatsmeow (go get go.mau.fi/whatsmeow@latest) and rebuild","since":"<NOW>","needs_action":true}}

