== sqlite_master
index idx_messages_chat_time (messages)
CREATE INDEX idx_messages_chat_time ON messages(chat_jid, timestamp)

index idx_messages_id (messages)
CREATE INDEX idx_messages_id ON messages(id)

index idx_messages_sender (messages)
CREATE INDEX idx_messages_sender ON messages(sender)

index idx_messages_time (messages)
CREATE INDEX idx_messages_time ON messages(timestamp)

index idx_reactions_message (reactions)
CREATE INDEX idx_reactions_message ON reactions(chat_jid, message_id)

index sqlite_autoindex_bridge_meta_1 (bridge_meta)


index sqlite_autoindex_chat_labels_1 (chat_labels)


index sqlite_autoindex_chats_1 (chats)


index sqlite_autoindex_event_responses_1 (event_responses)


index sqlite_autoindex_labels_1 (labels)


index sqlite_autoindex_messages_1 (messages)


index sqlite_autoindex_poll_votes_1 (poll_votes)


index sqlite_autoindex_polls_1 (polls)


index sqlite_autoindex_reactions_1 (reactions)


table bridge_meta (bridge_meta)
CREATE TABLE bridge_meta (
			key TEXT PRIMARY KEY,
			value TEXT
		)

table chat_labels (chat_labels)
CREATE TABLE chat_labels (
			chat_jid TEXT,
			label_id TEXT,
			PRIMARY KEY (chat_jid, label_id)
		)

table chats (chats)
CREATE TABLE chats (
			jid TEXT PRIMARY KEY,
			name TEXT,
			last_message_time TIMESTAMP
		, unread_count INTEGER NOT NULL DEFAULT 0, archived INTEGER NOT NULL DEFAULT 0, pinned INTEGER NOT NULL DEFAULT 0, muted_until INTEGER NOT NULL DEFAULT 0, deleted_at TIMESTAMP)

table event_responses (event_responses)
CREATE TABLE event_responses (
			message_id TEXT,
			chat_jid TEXT,
			responder_jid TEXT,
			responder_name TEXT,
			response TEXT, -- going, not going, maybe
			extra_guests INTEGER,
			timestamp TIMESTAMP,
			PRIMARY KEY (message_id, chat_jid, responder_jid)
		)

table labels (labels)
CREATE TABLE labels (
			id TEXT PRIMARY KEY,
			name TEXT,
			color INTEGER,
			deleted INTEGER NOT NULL DEFAULT 0
		)

table messages (messages)
CREATE TABLE messages (
			id TEXT,
			chat_jid TEXT,
			sender TEXT,
			content TEXT,
			timestamp TIMESTAMP,
			is_from_me BOOLEAN,
			media_type TEXT,
			filename TEXT,
			url TEXT,
			media_key BLOB,
			file_sha256 BLOB,
			file_enc_sha256 BLOB,
			file_length INTEGER, sender_jid TEXT, sender_name TEXT, direct_path TEXT, mimetype TEXT, quoted_id TEXT, quoted_sender TEXT, quoted_text TEXT, mentions TEXT, edited_at TIMESTAMP, deleted_at TIMESTAMP, media_width INTEGER, media_height INTEGER, media_seconds INTEGER, media_detail TEXT, starred INTEGER NOT NULL DEFAULT 0,
			PRIMARY KEY (id, chat_jid),
			FOREIGN KEY (chat_jid) REFERENCES chats(jid)
		)

table messages_fts (messages_fts)
CREATE VIRTUAL TABLE messages_fts USING fts5(
			content, content='messages', content_rowid='rowid',
			tokenize='unicode61 remove_diacritics 2'
		)

table messages_fts_config (messages_fts_config)
CREATE TABLE 'messages_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID

table messages_fts_data (messages_fts_data)
CREATE TABLE 'messages_fts_data'(id INTEGER PRIMARY KEY, block BLOB)

table messages_fts_docsize (messages_fts_docsize)
CREATE TABLE 'messages_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB)

table messages_fts_idx (messages_fts_idx)
CREATE TABLE 'messages_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID

table poll_votes (poll_votes)
CREATE TABLE poll_votes (
			message_id TEXT,
			chat_jid TEXT,
			voter_jid TEXT,
			voter_name TEXT,
			options TEXT, -- JSON array of the option names chosen
			timestamp TIMESTAMP,
			PRIMARY KEY (message_id, chat_jid, voter_jid)
		)

table polls (polls)
CREATE TABLE polls (
			message_id TEXT,
			chat_jid TEXT,
			question TEXT,
			options TEXT, -- JSON array of option names, in order
			selectable_count INTEGER,
			PRIMARY KEY (message_id, chat_jid)
		)

table reactions (reactions)
CREATE TABLE reactions (
			message_id TEXT,
			chat_jid TEXT,
			sender_jid TEXT,
			sender_name TEXT,
			emoji TEXT,
			timestamp TIMESTAMP,
			PRIMARY KEY (message_id, chat_jid, sender_jid)
		)

trigger messages_fts_delete (messages)
CREATE TRIGGER messages_fts_delete AFTER DELETE ON messages BEGIN
			INSERT INTO messages_fts(messages_fts, rowid, content) VALUES ('delete', old.rowid, old.content);
		END

trigger messages_fts_insert (messages)
CREATE TRIGGER messages_fts_insert AFTER INSERT ON messages BEGIN
			INSERT INTO messages_fts(rowid, content) VALUES (new.rowid, new.content);
		END

trigger messages_fts_update (messages)
CREATE TRIGGER messages_fts_update AFTER UPDATE OF content ON messages BEGIN
			INSERT INTO messages_fts(messages_fts, rowid, content) VALUES ('delete', old.rowid, old.content);
			INSERT INTO messages_fts(rowid, content) VALUES (new.rowid, new.content);
		END

